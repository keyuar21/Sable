        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({cluster=~\"$cluster\", namespace=~\"$namespace\", app=~\"$app\"}, pod)",
        "query": "label_values({cluster=~\"$cluster\", namespace=~\"$namespace\", app=~\"$app\"}, pod)",
        "refresh": 1,
