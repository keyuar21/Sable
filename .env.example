SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=

# Veriphone carrier lookup (https://veriphone.io) — server-side only.
VERIPHONE_API_KEY=your_veriphone_key_here

# Live tariff plans (optional). Without BOTH of these the recharge service
# serves its built-in sample catalogue instead.
#   PLAN_PROVIDER=rapidapi
#   RAPIDAPI_KEY=your_rapidapi_key
#   NIXINFO_CTRLKEY=your_nixinfo_ctrlkey   # from nixinfo.in
#   RAPIDAPI_HOST=...p.rapidapi.com        # from the playground code snippet
#   RAPIDAPI_PATH=/
PLAN_PROVIDER=builtin
